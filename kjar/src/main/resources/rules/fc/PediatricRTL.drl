package rules.fc;

import com.ftn.sbnz.model.domain.Athlete;
import com.ftn.sbnz.model.enums.AgeGroup;
import com.ftn.sbnz.model.facts.PediatricRtlPending;

rule "Pediatric RTL must complete before reaching step 6"
    when
        $a: Athlete(ageGroup == AgeGroup.PEDIATRIC,
                    currentStep >= 5,
                    returnToLearnComplete == false,
                    $aid: id)
        not PediatricRtlPending(athleteId == $aid)
    then
        insert(new PediatricRtlPending($aid,
            "Pediatric athlete must complete Return-To-Learn before Return-To-Sport (step 6)"));
end
