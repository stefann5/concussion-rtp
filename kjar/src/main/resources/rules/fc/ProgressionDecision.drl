package rules.fc;

import com.ftn.sbnz.model.domain.Athlete;
import com.ftn.sbnz.model.facts.ExertionIntoleranceFlag;
import com.ftn.sbnz.model.facts.RegressTrigger;
import com.ftn.sbnz.model.facts.MoreThanMildExacerbation;
import com.ftn.sbnz.model.facts.ProgressionStatusFact;
import com.ftn.sbnz.model.facts.StepRecommendation;
import com.ftn.sbnz.model.facts.ProtocolLockEvent;
import com.ftn.sbnz.model.enums.ProgressionStatus;
import com.ftn.sbnz.model.enums.ActionType;
import java.util.Date;

rule "Determine status STOP_AND_RETRY at steps 1-3"
    agenda-group "phase-decision"
    auto-focus true
    when
        $a: Athlete($aid: id, currentStep >= 1 && currentStep <= 3)
        (ExertionIntoleranceFlag(athleteId == $aid) or
         RegressTrigger(athleteId == $aid) or
         MoreThanMildExacerbation(athleteId == $aid))
        not ProgressionStatusFact(athleteId == $aid)
    then
        insert(new ProgressionStatusFact($aid, ProgressionStatus.STOP_TODAY_RETRY_TOMORROW,
            "Setback detected at steps 1-3: hold on the same step and retry next day"));
end

rule "Determine status REGRESS at steps 4-6"
    agenda-group "phase-decision"
    auto-focus true
    when
        $a: Athlete($aid: id, currentStep >= 4 && currentStep <= 6)
        (ExertionIntoleranceFlag(athleteId == $aid) or
         RegressTrigger(athleteId == $aid) or
         MoreThanMildExacerbation(athleteId == $aid))
        not ProgressionStatusFact(athleteId == $aid)
    then
        insert(new ProgressionStatusFact($aid, ProgressionStatus.REGRESS_TO_STEP_3,
            "Setback detected at steps 4-6: regress to step 3 per Amsterdam 2022"));
end

rule "Recommend HOLD on current step (steps 1-3)"
    agenda-group "phase-decision"
    auto-focus true
    salience -10
    when
        $a: Athlete($aid: id, $cur: currentStep)
        ProgressionStatusFact(athleteId == $aid, status == ProgressionStatus.STOP_TODAY_RETRY_TOMORROW)
        not StepRecommendation(athleteId == $aid)
    then
        insert(new StepRecommendation($aid, ActionType.STOP_AND_RETRY, $cur, $cur, 24,
            "Hold today, retry the same step in 24 hours"));
        insert(new ProtocolLockEvent($aid, 24, "STOP_AND_RETRY_SAME_STEP", new Date()));
end

rule "Recommend REGRESS to step 3 (steps 4-6)"
    agenda-group "phase-decision"
    auto-focus true
    salience -10
    when
        $a: Athlete($aid: id, $cur: currentStep)
        ProgressionStatusFact(athleteId == $aid, status == ProgressionStatus.REGRESS_TO_STEP_3)
        not StepRecommendation(athleteId == $aid)
    then
        insert(new StepRecommendation($aid, ActionType.REGRESS, $cur, 3, 24,
            "Regress to step 3 per Amsterdam 2022 — confirm full symptom resolution before reintroducing head-impact risk"));
        insert(new ProtocolLockEvent($aid, 24, "REGRESS_TO_STEP_3", new Date()));
        modify($a) { setCurrentStep(3) }
end
