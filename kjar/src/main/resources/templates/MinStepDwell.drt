template header
contactLevel
historyFlag
minHours

package rules.templates;

import com.ftn.sbnz.model.domain.Athlete;
import com.ftn.sbnz.model.facts.MinStepDwellRule;
import com.ftn.sbnz.model.enums.ContactLevel;
import com.ftn.sbnz.model.enums.HistoryFlag;

template "MinStepDwellTemplate"

rule "MinStepDwell @{row.rowNumber} @{contactLevel} @{historyFlag}"
when
    $a: Athlete(contactLevel == ContactLevel.@{contactLevel},
                historyFlag == HistoryFlag.@{historyFlag})
    not MinStepDwellRule(athleteId == $a.id)
then
    insert(new MinStepDwellRule($a.getId(), @{minHours}));
end

end template
